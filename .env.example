# Cobra Coaching Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.

DJANGO_DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Database Settings (MySQL via PyMySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=attendance_db
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email Settings (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=coachingcobra@gmail.com
EMAIL_HOST_PASSWORD=fmxi rzdt gsty oabc
DEFAULT_FROM_EMAIL="Cobra Coaching <coachingcobra@gmail.com>"
EMAIL_TIMEOUT=20
APP_BASE_URL=http://127.0.0.1:8000

# Attendance Correction Settings
ATTENDANCE_CORRECTION_WINDOW_DAYS=7
ATTENDANCE_BATCH_MINUTES=30
ATTENDANCE_LINK_EXPIRY_HOURS=48
REQUIRE_AUTHENTICATED_REVIEW=False
